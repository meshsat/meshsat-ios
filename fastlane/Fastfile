# fastlane lanes for MeshSat iOS. Every lane assumes `xcodegen generate` has run.
#
#   fastlane test            unit tests on a simulator
#   fastlane build_unsigned  Release build with signing off -> MeshSat-<v>-unsigned.ipa
#                            and a Debug simulator build -> MeshSat-<v>-simulator.zip
#   fastlane screenshots     the parity screenshot suite (UI tests) on the iPhone 16 simulator
#   fastlane beta            match + gym + pilot; refuses to run until the App Store Connect
#                            API key is present in the environment (MESHSAT-1331)
default_platform(:ios)

PROJECT = "MeshSat.xcodeproj"
SCHEME = "MeshSat"
SIMULATOR = "iPhone 16"

# The App Store Connect REST API with the key fastlane already loaded, for the endpoints
# Spaceship has no model for (price schedules, availability, submissions).
def asc_rest(method, path, body = nil)
  require "net/http"
  require "json"
  uri = URI("https://api.appstoreconnect.apple.com/#{path}")
  req = { post: Net::HTTP::Post, patch: Net::HTTP::Patch, get: Net::HTTP::Get }.fetch(method).new(uri)
  req["Authorization"] = "Bearer #{Spaceship::ConnectAPI.token.text}"
  req["Content-Type"] = "application/json"
  req.body = body.to_json if body
  res = Net::HTTP.start(uri.host, uri.port, use_ssl: true) { |h| h.request(req) }
  [res.code.to_i, (JSON.parse(res.body) rescue {})]
end

def marketing_version
  File.read("../Config/Version.xcconfig")[/^MARKETING_VERSION\s*=\s*([\d.]+)/, 1]
end

platform :ios do
  desc "Unit tests on the simulator"
  lane :test do
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      devices: [SIMULATOR],
      # The UI tests are in the scheme so the phone tour can be built (uitest_build); on the
      # simulator they only try to launch the app, which the CI Mac's simulator refuses.
      only_testing: ["MeshSatTests"],
      # The CI Mac's simulator wedged twice on 25 Sep 2026 ("Busy: Application failed preflight
      # checks" on every launch, pipelines 56377 and 56381): start each run from a quit, erased device.
      force_quit_simulator: true,
      reset_simulator: true,
      xcargs: "CODE_SIGNING_ALLOWED=NO",
      result_bundle: true,
      output_directory: "fastlane/test_output"
    )
  end

  desc "Unsigned Release .ipa for sideloading, plus a simulator build"
  lane :build_unsigned do
    v = marketing_version
    sh("cd .. && xcodebuild build -project #{PROJECT} -scheme #{SCHEME} -configuration Release " \
       "-sdk iphoneos -destination 'generic/platform=iOS' -derivedDataPath build " \
       "CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY='' | tail -50")
    sh("cd .. && rm -rf Payload && mkdir Payload && cp -R build/Build/Products/Release-iphoneos/MeshSat.app Payload/ " \
       "&& zip -qr MeshSat-#{v}-unsigned.ipa Payload && rm -rf Payload")
    sh("cd .. && xcodebuild build -project #{PROJECT} -scheme #{SCHEME} -configuration Debug " \
       "-sdk iphonesimulator -destination 'platform=iOS Simulator,name=#{SIMULATOR}' -derivedDataPath build-sim " \
       "CODE_SIGNING_ALLOWED=NO | tail -20")
    sh("cd ../build-sim/Build/Products/Debug-iphonesimulator && zip -qr ../../../../MeshSat-#{v}-simulator.zip MeshSat.app")
  end

  desc "Parity screenshot suite on the iPhone 16 simulator"
  lane :screenshots do
    capture_screenshots(
      project: PROJECT,
      scheme: SCHEME,
      devices: [SIMULATOR],
      languages: ["en-US"],
      output_directory: "docs/screenshots/simulator",
      clear_previous_screenshots: true,
      override_status_bar: true
    )
  end

  # The App Store Connect API key from the environment (OpenBao secret/ci-no/apps/meshsat-ios/asc-api-key).
  private_lane :asc_key do
    key_id = ENV["ASC_KEY_ID"]
    issuer = ENV["ASC_ISSUER_ID"]
    key_b64 = ENV["ASC_KEY_P8_B64"]
    UI.user_error!("ASC_KEY_ID, ASC_ISSUER_ID and ASC_KEY_P8_B64 are not set; no signing material yet") if key_id.nil? || issuer.nil? || key_b64.nil?
    app_store_connect_api_key(key_id: key_id, issuer_id: issuer, key_content: key_b64, is_key_content_base64: true, in_house: false)
  end

  # The match profile on the generated project: manual signing with the Apple Distribution
  # certificate, so the archive needs no Xcode account (MATCH_GIT_URL and MATCH_PASSWORD from
  # OpenBao secret/ci-no/apps/meshsat-ios/match).
  private_lane :sign_with_match do
    match(type: "appstore", readonly: is_ci)
    update_code_signing_settings(
      path: PROJECT, targets: [SCHEME], use_automatic_signing: false, team_id: "4CXPKM8L4V",
      code_sign_identity: "Apple Distribution", profile_name: ENV["sigh_net.meshsat.ios_appstore_profile-name"],
      bundle_identifier: "net.meshsat.ios"
    )
  end

  desc "Signed App Store archive -> MeshSat-<v>.ipa (no upload)"
  lane :build_signed do
    asc_key
    sign_with_match
    build_app(project: PROJECT, scheme: SCHEME, export_method: "app-store", output_directory: ".", output_name: "MeshSat-#{marketing_version}.ipa")
  end

  # A development-signed .ipa for the test iPhone over USB (pymobiledevice3 apps install on the
  # laptop). TestFlight builds cannot be sideloaded; this one can. DEVICE_UDID and DEVICE_NAME
  # name the phone; match keeps the development certificate and profile next to the App Store ones.
  desc "Development-signed .ipa for the test phone -> MeshSat-<v>-dev.ipa"
  lane :device_build do
    asc_key
    udid = ENV["DEVICE_UDID"]
    UI.user_error!("DEVICE_UDID is not set") if udid.nil?
    register_devices(devices: { (ENV["DEVICE_NAME"] || "MeshSat test iPhone") => udid })
    match(type: "development", readonly: false, force_for_new_devices: true)
    update_code_signing_settings(
      path: PROJECT, targets: [SCHEME], use_automatic_signing: false, team_id: "4CXPKM8L4V",
      code_sign_identity: "Apple Development", profile_name: ENV["sigh_net.meshsat.ios_development_profile-name"],
      bundle_identifier: "net.meshsat.ios"
    )
    build_app(project: PROJECT, scheme: SCHEME, export_method: "development", output_directory: ".", output_name: "MeshSat-#{marketing_version}-dev.ipa")
  end

  # The app and its UI test runner, both development-signed, built for testing on the phone so the
  # laptop can install them and run the tour (pymobiledevice3 developer dvt xcuitest). The runner
  # is net.meshsat.ios.uitests.xctrunner, covered by a wildcard App ID net.meshsat.ios.* that this
  # lane creates once. Output: build-uitest/Build/Products/Release-iphoneos/{MeshSat,MeshSatUITests-Runner}.app
  desc "Development-signed app + UI test runner for the test phone"
  lane :uitest_build do
    asc_key
    udid = ENV["DEVICE_UDID"]
    UI.user_error!("DEVICE_UDID is not set") if udid.nil?
    register_devices(devices: { (ENV["DEVICE_NAME"] || "MeshSat test iPhone") => udid })
    wildcard = "net.meshsat.ios.*"
    existing = Spaceship::ConnectAPI::BundleId.all(filter: { identifier: wildcard }).select { |b| b.identifier == wildcard }
    if existing.empty?
      Spaceship::ConnectAPI::BundleId.create(name: "MeshSat iOS test bundles", identifier: wildcard, platform: "IOS")
      UI.message("Created the wildcard App ID #{wildcard}")
    end
    match(type: "development", readonly: false, force_for_new_devices: true, app_identifier: ["net.meshsat.ios", wildcard])
    update_code_signing_settings(
      path: PROJECT, targets: [SCHEME], use_automatic_signing: false, team_id: "4CXPKM8L4V",
      code_sign_identity: "Apple Development", profile_name: ENV["sigh_net.meshsat.ios_development_profile-name"],
      bundle_identifier: "net.meshsat.ios"
    )
    { "MeshSatUITests" => "net.meshsat.ios.uitests", "MeshSatTests" => "net.meshsat.ios.tests" }.each do |target, bundle|
      update_code_signing_settings(
        path: PROJECT, targets: [target], use_automatic_signing: false, team_id: "4CXPKM8L4V",
        code_sign_identity: "Apple Development", profile_name: ENV["sigh_net.meshsat.ios.*_development_profile-name"],
        bundle_identifier: bundle
      )
    end
    sh("cd .. && rm -rf build-uitest && xcodebuild build-for-testing -project #{PROJECT} -scheme #{SCHEME} " \
       "-configuration Release -destination 'generic/platform=iOS' -derivedDataPath build-uitest " \
       "-allowProvisioningUpdates=NO 2>&1 | grep -E 'error:|warning: .*provision|BUILD (SUCCEEDED|FAILED)' | sort -u")
    sh("cd ../build-uitest/Build/Products/Release-iphoneos && ls -d *.app && tar czf ../../../../uitest-apps.tgz MeshSat.app MeshSatUITests-Runner.app")
  end

  # The App Store listing without submitting it: text from fastlane/metadata, the real-phone
  # screenshots from fastlane/screenshots (6.5 inch, 1242 x 2688), the pending version renamed to
  # the marketing version and given the newest processed build, the category, the age rating and
  # the content-rights answer. App privacy and the trader details are web-only in App Store
  # Connect. BUILD_NUMBER picks the build (default: the newest valid one).
  desc "Upload the App Store listing and attach a build; does not submit"
  lane :store_listing do
    asc_key
    app = Spaceship::ConnectAPI::App.find("net.meshsat.ios")
    build = ENV["BUILD_NUMBER"] ? Spaceship::ConnectAPI::Build.all(app_id: app.id, build_number: ENV["BUILD_NUMBER"]).first : Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 1).first
    UI.user_error!("no build") if build.nil?
    # deliver cannot create the App Review details of a first version; they are made here once,
    # and App Store Connect will not make them without the contact phone
    # (REVIEW_PHONE in the environment). Until then the text metadata waits too:
    # deliver reads the review details before it writes any text.
    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    review = File.join(__dir__, "metadata", "review_information")
    read = lambda do |name|
      # The phone comes from the environment only (REVIEW_PHONE), never from a file in git.
      next ENV["REVIEW_PHONE"] if name == "phone_number"
      path = File.join(review, "#{name}.txt")
      File.exist?(path) ? File.read(path).strip : nil
    end
    have_review = begin
      version.fetch_app_store_review_detail
      true
    rescue RuntimeError
      if read.call("phone_number").to_s.empty?
        UI.important("No review contact phone yet: text metadata and review details wait")
        false
      else
        version.create_app_store_review_detail(attributes: {
          contactFirstName: read.call("first_name"), contactLastName: read.call("last_name"),
          contactEmail: read.call("email_address"), contactPhone: read.call("phone_number"),
          notes: read.call("notes"), demoAccountRequired: false
        })
        UI.message("App Review details created")
        true
      end
    end
    deliver(
      app_identifier: "net.meshsat.ios", app_version: marketing_version, skip_binary_upload: true,
      build_number: build.version, metadata_path: "./fastlane/metadata", screenshots_path: "./fastlane/screenshots",
      skip_metadata: !have_review, overwrite_screenshots: true, force: true, submit_for_review: false,
      run_precheck_before_submit: false, primary_category: "UTILITIES", secondary_category: "NAVIGATION",
      ignore_language_directory_validation: true
    )
    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    version.select_build(build_id: build.id)
    unless have_review
      # deliver's text upload waits for the review details; write the same text directly.
      meta = ->(name) { path = File.join(__dir__, "metadata", "en-US", "#{name}.txt"); File.exist?(path) ? File.read(path).strip : nil }
      loc = version.get_app_store_version_localizations.find { |l| l.locale == "en-US" }
      loc.update(attributes: {
        description: meta.call("description"), keywords: meta.call("keywords"), promotionalText: meta.call("promotional_text"),
        supportUrl: meta.call("support_url"), marketingUrl: meta.call("marketing_url")
      }.compact)
      info = app.fetch_edit_app_info
      info.get_app_info_localizations.find { |l| l.locale == "en-US" }.update(attributes: {
        name: meta.call("name"), subtitle: meta.call("subtitle"), privacyPolicyUrl: meta.call("privacy_url")
      }.compact)
      version.update(attributes: { copyright: File.read(File.join(__dir__, "metadata", "copyright.txt")).strip }) if File.exist?(File.join(__dir__, "metadata", "copyright.txt"))
      info.update_categories(category_id_map: { primary_category_id: "UTILITIES", secondary_category_id: "NAVIGATION" })
    end
    # Messaging between people on the mesh, nothing else on Apple's list; no web view, no ads.
    info = app.fetch_edit_app_info
    info.fetch_age_rating_declaration.update(attributes: {
      alcoholTobaccoOrDrugUseOrReferences: "NONE", contests: "NONE", gamblingSimulated: "NONE",
      horrorOrFearThemes: "NONE", matureOrSuggestiveThemes: "NONE", medicalOrTreatmentInformation: "NONE",
      profanityOrCrudeHumor: "NONE", sexualContentGraphicAndNudity: "NONE", sexualContentOrNudity: "NONE",
      violenceCartoonOrFantasy: "NONE", violenceRealistic: "NONE", violenceRealisticProlongedGraphicOrSadistic: "NONE",
      gunsOrOtherWeapons: "NONE", gambling: false, unrestrictedWebAccess: false, lootBox: false,
      messagingAndChat: true, userGeneratedContent: false, advertising: false, healthOrWellnessTopics: false,
      parentalControls: false, ageAssurance: false
    })
    # OpenStreetMap tiles are third-party content, used under the ODbL.
    app.update(attributes: { contentRightsDeclaration: "USES_THIRD_PARTY_CONTENT" })
    UI.success("Listing uploaded for #{marketing_version} (#{build.version}); not submitted")
  end

  # Free, and on sale in every App Store country except mainland China, where Apple needs a
  # government ICP filing for the app first. EXCLUDE_TERRITORIES (comma separated, ISO 3166
  # alpha-3) overrides the list. Safe to run again: it only creates what is missing.
  desc "Make the app free and set the countries it is sold in"
  lane :store_price_availability do
    asc_key
    app = Spaceship::ConnectAPI::App.find("net.meshsat.ios")
    exclude = (ENV["EXCLUDE_TERRITORIES"] || "CHN").split(",").map(&:strip)
    code, body = asc_rest(:get, "v1/appPriceSchedules/#{app.id}/manualPrices?limit=1")
    if code == 200 && !(body["data"] || []).empty?
      UI.message("A price is already set")
    else
      _, points = asc_rest(:get, "v1/apps/#{app.id}/appPricePoints?filter[territory]=USA&limit=200")
      free = (points["data"] || []).find { |p| p["attributes"]["customerPrice"].to_f.zero? }
      UI.user_error!("no free price point") if free.nil?
      code, body = asc_rest(:post, "v1/appPriceSchedules", {
        data: { type: "appPriceSchedules", relationships: {
          app: { data: { type: "apps", id: app.id } },
          baseTerritory: { data: { type: "territories", id: "USA" } },
          manualPrices: { data: [{ type: "appPrices", id: "${free}" }] }
        } },
        included: [{ type: "appPrices", id: "${free}", attributes: { startDate: nil },
                     relationships: { appPricePoint: { data: { type: "appPricePoints", id: free["id"] } } } }]
      })
      UI.user_error!("price: #{code} #{body.to_s[0, 300]}") unless code == 201
      UI.success("Price set: free")
    end
    code, = asc_rest(:get, "v1/apps/#{app.id}/appAvailabilityV2")
    if code == 200
      UI.message("Availability is already set")
    else
      _, terr = asc_rest(:get, "v1/territories?limit=200")
      # Every country goes in the request, the excluded ones as not available.
      all = (terr["data"] || []).map { |t| t["id"] }
      ids = all
      code, body = asc_rest(:post, "v2/appAvailabilities", {
        data: { type: "appAvailabilities", attributes: { availableInNewTerritories: true }, relationships: {
          app: { data: { type: "apps", id: app.id } },
          territoryAvailabilities: { data: ids.map { |t| { type: "territoryAvailabilities", id: "${ta-#{t.downcase}}" } } }
        } },
        included: ids.map { |t| { type: "territoryAvailabilities", id: "${ta-#{t.downcase}}", attributes: { available: !exclude.include?(t), releaseDate: nil, preOrderEnabled: false },
                                   relationships: { territory: { data: { type: "territories", id: t } } } } }
      })
      UI.user_error!("availability: #{code} #{(body["errors"] || []).map { |e| e["detail"] }.join(" | ")}") unless code == 201
      UI.success("Available in #{(all - exclude).size} countries (not #{exclude.join(", ")})")
    end
  end

  # Sends the pending version to App Review. Release is manual: an approved version waits for a
  # person to press Release in App Store Connect. Run store_listing first.
  desc "Submit the pending App Store version for review (manual release)"
  lane :store_submit do
    asc_key
    app = Spaceship::ConnectAPI::App.find("net.meshsat.ios")
    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    version.update(attributes: { releaseType: "MANUAL" })
    # A refused try leaves a draft submission behind: take it rather than make another.
    _, drafts = asc_rest(:get, "v1/reviewSubmissions?filter[app]=#{app.id}&filter[platform]=IOS&filter[state]=READY_FOR_REVIEW&include=items")
    draft = (drafts["data"] || []).first
    if draft
      submission = draft["id"]
      has_item = !(draft.dig("relationships", "items", "data") || []).empty?
    else
      code, body = asc_rest(:post, "v1/reviewSubmissions", {
        data: { type: "reviewSubmissions", attributes: { platform: "IOS" },
                relationships: { app: { data: { type: "apps", id: app.id } } } }
      })
      UI.user_error!("submission: #{code} #{(body["errors"] || []).map { |e| e["detail"] }.join(" | ")}") unless code == 201
      submission = body["data"]["id"]
      has_item = false
    end
    code, body = has_item ? [201, {}] : asc_rest(:post, "v1/reviewSubmissionItems", {
      data: { type: "reviewSubmissionItems", relationships: {
        reviewSubmission: { data: { type: "reviewSubmissions", id: submission } },
        appStoreVersion: { data: { type: "appStoreVersions", id: version.id } }
      } }
    })
    UI.user_error!("item: #{code} #{JSON.generate(body["errors"] || [])[0, 3000]}") unless code == 201 # associatedErrors name what is missing
    code, body = asc_rest(:patch, "v1/reviewSubmissions/#{submission}", {
      data: { type: "reviewSubmissions", id: submission, attributes: { submitted: true } }
    })
    UI.user_error!("submit: #{code} #{(body["errors"] || []).map { |e| e["detail"] }.join(" | ")}") unless code == 200
    UI.success("#{version.version_string} is waiting for App Review (submission #{submission})")
  end

  desc "TestFlight build (needs the App Store Connect API key, MESHSAT-1331)"
  lane :beta do
    asc_key
    sign_with_match
    build_app(project: PROJECT, scheme: SCHEME, export_method: "app-store", output_directory: ".", output_name: "MeshSat-#{marketing_version}.ipa")
    upload_to_testflight(skip_waiting_for_build_processing: true, changelog: File.read("metadata/en-US/release_notes.txt"))
  end
end
